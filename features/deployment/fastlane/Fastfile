require 'json'

default_platform(:ios)

# Release notes per language from RELEASE_NOTES_JSON ({"en-US" => "..."}); {} when none.
def notes_by_locale
  raw = ENV['RELEASE_NOTES_JSON'].to_s.strip
  return {} if raw.empty?
  parsed = JSON.parse(raw)
  parsed.is_a?(Hash) ? parsed.reject { |_, t| t.to_s.strip.empty? } : {}
rescue JSON::ParserError
  UI.important('RELEASE_NOTES_JSON is not valid JSON; uploading without release notes')
  {}
end

# Languages of the Play listing. supply requests every locale folder it finds, and
# Play rejects ("Invalid request") any language the app has no listing for.
def play_listing_languages(package_name, json_key_input)
  options = { package_name: package_name }
  File.exist?(json_key_input) ? options[:json_key] = json_key_input : options[:json_key_data] = json_key_input
  Supply.config = FastlaneCore::Configuration.create(Supply::Options.available_options, options)
  client = Supply::Client.make_from_config
  client.begin_edit(package_name: package_name)
  languages = client.listings.map(&:language)
  client.abort_current_edit
  languages
end

# Keeps only the notes whose language the listing has (exact, case-insensitive, or
# same base language: "de" -> "de-DE"); the rest are skipped with a warning.
def notes_for_listing(notes, languages)
  result = {}
  notes.each do |locale, text|
    target = languages.find { |l| l.casecmp(locale).zero? } ||
             languages.find { |l| l.split('-').first.casecmp(locale.split('-').first).zero? }
    if target
      result[target] ||= text
    else
      UI.important("No Play listing for '#{locale}'; skipping its release notes")
    end
  end
  result
end

# Builds an App Store Connect API key from the key id/issuer and the .p8
# (base64 content, or a file found in the usual key folders).
def asc_api_key(key_id, issuer_id, key_base64)
  if key_base64.to_s.strip.empty?
    workspace_root = ENV['MELOS_ROOT_PATH'] || Dir.pwd
    candidates = [
      ENV['APPLE_API_KEY_PATH'],
      File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8"),
      File.expand_path("~/.private_keys/AuthKey_#{key_id}.p8"),
      File.join(workspace_root, 'private_keys', "AuthKey_#{key_id}.p8")
    ].compact

    resolved_key_path = candidates.find { |p| File.exist?(p) }
    UI.user_error!("APPLE_API_KEY file not found for key '#{key_id}'. Checked ~/.appstoreconnect/private_keys/ and workspace.") unless resolved_key_path

    key_base64 = Base64.strict_encode64(File.read(resolved_key_path))
  end

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_content: key_base64,
    is_key_content_base64: true
  )
end

platform :android do
  desc 'Upload AAB to Google Play Store'
  lane :upload_android do |options|
    aab_path = ENV['ANDROID_AAB_PATH']
    package_name = ENV['ANDROID_PACKAGE_NAME']
    json_key_input = ENV['SERVICE_ACCOUNT_JSON']
    track = options[:track] || 'internal'
    release_status = options[:release_status] || 'draft'

    UI.user_error!('ANDROID_AAB_PATH is missing') if aab_path.to_s.empty?
    UI.user_error!('ANDROID_PACKAGE_NAME is missing') if package_name.to_s.empty?
    UI.user_error!('SERVICE_ACCOUNT_JSON is missing') if json_key_input.to_s.empty?

    json_key = nil
    json_key_data = nil

    if File.exist?(json_key_input)
      json_key = json_key_input
    else
      json_key_data = json_key_input
    end

    notes = notes_by_locale
    unless notes.empty?
      begin
        notes = notes_for_listing(notes, play_listing_languages(package_name, json_key_data || json_key_input))
      rescue StandardError => e
        UI.important("Could not read the Play listing languages (#{e.message}); uploading without release notes")
        notes = {}
      end
    end

    # upload_to_play_store has no release_notes option: changelogs are read from
    # <metadata_path>/<locale>/changelogs/default.txt.
    metadata_dir = nil
    unless notes.empty?
      require 'tmpdir'
      require 'fileutils'
      metadata_dir = Dir.mktmpdir('play_notes')
      notes.each do |locale, text|
        dir = File.join(metadata_dir, locale, 'changelogs')
        FileUtils.mkdir_p(dir)
        File.write(File.join(dir, 'default.txt'), text.to_s.strip)
      end
    end

    upload_to_play_store(
      package_name: package_name,
      track: track,
      aab: aab_path,
      json_key: json_key,
      json_key_data: json_key_data,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: notes.empty?,
      metadata_path: metadata_dir,
      release_status: release_status
    )
  end

  desc 'List the languages of the Play Store listing (writes JSON to LOCALES_OUT)'
  lane :list_locales do
    package_name = ENV['ANDROID_PACKAGE_NAME']
    json_key_input = ENV['SERVICE_ACCOUNT_JSON']
    out = ENV['LOCALES_OUT']
    UI.user_error!('ANDROID_PACKAGE_NAME is missing') if package_name.to_s.empty?
    UI.user_error!('SERVICE_ACCOUNT_JSON is missing') if json_key_input.to_s.empty?
    UI.user_error!('LOCALES_OUT is missing') if out.to_s.empty?

    options = { package_name: package_name }
    File.exist?(json_key_input) ? options[:json_key] = json_key_input : options[:json_key_data] = json_key_input
    Supply.config = FastlaneCore::Configuration.create(Supply::Options.available_options, options)
    client = Supply::Client.make_from_config
    client.begin_edit(package_name: package_name)
    languages = client.listings.map(&:language)
    client.abort_current_edit
    File.write(out, JSON.generate(languages))
  end
end

platform :ios do
  desc 'Upload IPA to TestFlight'
  lane :testflight_build do
    ipa_path = ENV['IOS_IPA_PATH']
    key_id = ENV['APPLE_API_KEY']
    issuer_id = ENV['APPLE_API_ISSUER']
    key_base64 = ENV['APPLE_API_KEY_BASE64']

    UI.user_error!('IOS_IPA_PATH is missing') if ipa_path.to_s.empty?
    UI.user_error!('APPLE_API_KEY is missing') if key_id.to_s.empty?
    UI.user_error!('APPLE_API_ISSUER is missing') if issuer_id.to_s.empty?

    api_key = asc_api_key(key_id, issuer_id, key_base64)

    notes = notes_by_locale
    first_notes = notes.values.first

    # TestFlight only attaches "What to Test" once Apple has finished processing.
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      changelog: first_notes,
      localized_build_info: notes.empty? ? nil : notes.transform_values { |t| { whats_new: t } },
      skip_waiting_for_build_processing: notes.empty?,
      distribute_external: false
    )
  end

  desc 'Set the "What to Test" notes of an already-uploaded build (IOS_BUNDLE_ID, IOS_BUILD_NUMBER, RELEASE_NOTES)'
  lane :update_testflight_notes do
    bundle_id = ENV['IOS_BUNDLE_ID']
    build_number = ENV['IOS_BUILD_NUMBER']
    notes = ENV['RELEASE_NOTES'].to_s.strip
    locale = ENV['RELEASE_LOCALE'] || 'en-US'
    key_id = ENV['APPLE_API_KEY']
    issuer_id = ENV['APPLE_API_ISSUER']

    UI.user_error!('IOS_BUNDLE_ID is missing') if bundle_id.to_s.empty?
    UI.user_error!('IOS_BUILD_NUMBER is missing') if build_number.to_s.empty?
    UI.user_error!('RELEASE_NOTES is empty') if notes.empty?
    UI.user_error!('APPLE_API_KEY is missing') if key_id.to_s.empty?
    UI.user_error!('APPLE_API_ISSUER is missing') if issuer_id.to_s.empty?

    asc_api_key(key_id, issuer_id, ENV['APPLE_API_KEY_BASE64'])

    app = Spaceship::ConnectAPI::App.find(bundle_id)
    UI.user_error!("No app with bundle id #{bundle_id} in App Store Connect") unless app

    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, build_number: build_number, sort: '-uploadedDate', limit: 1).first
    UI.user_error!("Build #{build_number} not found (or still processing) for #{bundle_id}") unless build

    localization = build.get_beta_build_localizations(filter: { locale: locale }).first
    if localization
      localization.update(attributes: { whats_new: notes })
    else
      build.create_beta_build_localization(attributes: { locale: locale, whats_new: notes })
    end
    UI.success("Updated TestFlight notes for #{bundle_id} build #{build_number} (#{locale})")
  end

  desc 'List the languages of the App Store listing (writes JSON to LOCALES_OUT)'
  lane :list_locales do
    bundle_id = ENV['IOS_BUNDLE_ID']
    out = ENV['LOCALES_OUT']
    key_id = ENV['APPLE_API_KEY']
    issuer_id = ENV['APPLE_API_ISSUER']
    UI.user_error!('IOS_BUNDLE_ID is missing') if bundle_id.to_s.empty?
    UI.user_error!('LOCALES_OUT is missing') if out.to_s.empty?
    UI.user_error!('APPLE_API_KEY / APPLE_API_ISSUER is missing') if key_id.to_s.empty? || issuer_id.to_s.empty?

    asc_api_key(key_id, issuer_id, ENV['APPLE_API_KEY_BASE64'])
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    UI.user_error!("No app with bundle id #{bundle_id} in App Store Connect") unless app

    version = app.get_edit_app_store_version || app.get_live_app_store_version
    locales = version ? version.get_app_store_version_localizations.map(&:locale) : []
    File.write(out, JSON.generate(locales))
  end
end
