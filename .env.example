# Dev-Deployment Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Path to the mobile app or monorepo workspace to manage
WORKSPACE_ROOT=/path/to/your/workspace

# Port for the deployment dashboard server (default: 18112)
DEPLOYMENT_PORT=18112

# Temporary directory for logs and command execution
# DEPLOYMENT_TMP_DIR=/tmp/deployment_dashboard_tmp

# Optional Apple Developer Team ID fallback
# DEFAULT_TEAM_ID=

# Optional Google Chat webhook for deployment notifications
# GOOGLE_CHAT_WEBHOOK_URL=
